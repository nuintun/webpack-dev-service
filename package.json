{
  "name": "webpack-dev-service",
  "version": "0.18.1",
  "description": "A koa 2 middleware for webpack development and hot reloading.",
  "type": "module",
  "sideEffects": [
    "esm/client/main.js",
    "cjs/client/main.cjs"
  ],
  "exports": {
    ".": {
      "import": "./esm/server/index.js",
      "require": "./cjs/server/index.cjs",
      "default": "./esm/server/index.js"
    },
    "./client": {
      "import": "./esm/client/index.js",
      "require": "./cjs/client/index.cjs",
      "default": "./esm/client/index.js"
    }
  },
  "files": [
    "cjs",
    "esm",
    "global.d.ts"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuintun/webpack-dev-service.git"
  },
  "keywords": [
    "dev",
    "koa",
    "server",
    "webpack",
    "middleware"
  ],
  "author": {
    "name": "nuintun",
    "email": "nuintun@qq.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nuintun/webpack-dev-service/issues"
  },
  "homepage": "https://github.com/nuintun/webpack-dev-service#readme",
  "scripts": {
    "lint": "tsc --noEmit",
    "pretest": "pnpm build",
    "clean": "node tools/clean.ts",
    "prepublishOnly": "pnpm build",
    "test": "cd tests && node webpack.config.ts",
    "build:cjs": "rollup -c tools/rollup.cjs.ts",
    "build:esm": "rollup -c tools/rollup.esm.ts",
    "build:fix-types": "node tools/fix-types.ts",
    "build": "pnpm clean && pnpm build:main && pnpm format",
    "format": "prettier --write . --ignore-path .prettierignore",
    "build:main": "pnpm build:cjs && pnpm build:esm && pnpm build:fix-types"
  },
  "dependencies": {
    "@nuintun/ansi": "^0.3.13",
    "@types/koa": "^3.0.3",
    "@types/ws": "^8.18.2",
    "etag": "^1.8.1",
    "memfs": "^4.80.0",
    "range-parser": "^1.3.0",
    "schema-utils": "^4.8.3",
    "supports-color": "^11.0.0",
    "tslib": "^2.9.1",
    "uuid": "^14.0.3",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@rollup/plugin-url": "^8.0.2",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@types/etag": "^1.8.4",
    "@types/node": "^26.6.6",
    "@types/range-parser": "^1.2.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.5",
    "dts-paths": "^2.2.2",
    "html-webpack-plugin": "^5.6.8",
    "koa": "^3.3.0",
    "koa-compress": "^5.3.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.2",
    "swc-loader": "^0.2.7",
    "typescript": "^6.0.3",
    "webpack": "^5.112.2"
  },
  "peerDependencies": {
    "koa": ">=2.0.0",
    "webpack": ">=5.20.0"
  }
}
